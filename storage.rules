rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    // Public content images are readable by anyone (the public site);
    // uploads require an authenticated admin (see firestore.rules'
    // admins/{uid} allowlist, mirrored here).
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
