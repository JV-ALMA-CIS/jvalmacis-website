{
  "firestore": {
    "database": "(default)",
    "location": "us-central1",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "firestore": { "port": 8085 },
    "functions": { "port": 5011 },
    "hosting": { "port": 5015 },
    "ui": { "enabled": false }
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "website",
      "runtime": "nodejs22",
      "ignore": ["node_modules", "test", "*.log"]
    }
  ],
  "hosting": {
    "public": "build/web",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**", "**/*.apk"],
    "rewrites": [
      {
        "source": "/api/chat",
        "function": { "functionId": "askAlma", "region": "us-central1" }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/community-development{,/}",
        "destination": "/community-impact",
        "type": 301
      },
      {
        "source": "/:path*\\?fbclid=:fbclid",
        "destination": "https://jvalmacis.com/:path*",
        "type": 301
      }
    ],
    "headers": [
  {
    "source": "/index.html",
    "headers": [
      {
        "key": "Cache-Control",
        "value": "no-cache, no-store, must-revalidate"
      }
    ]
  },
  {
    "source": "/flutter_service_worker.js",
    "headers": [
      {
        "key": "Cache-Control",
        "value": "no-cache, no-store, must-revalidate"
      }
    ]
  },
  {
    "source": "/manifest.json",
    "headers": [
      {
        "key": "Cache-Control",
        "value": "no-cache, no-store, must-revalidate"
      }
    ]
  },
  {
    "source": "**/*.@(js|css|html)",
    "headers": [
      {
        "key": "Cache-Control",
        "value": "no-cache, must-revalidate"
      }
    ]
  },
  {
    "source": "/assets/**",
    "headers": [
      {
        "key": "Cache-Control",
        "value": "public, max-age=31536000, immutable"
      }
    ]
  },
  {
    "source": "**/*.@(ttf|otf|woff|woff2)",
    "headers": [
      {
        "key": "Cache-Control",
        "value": "public, max-age=31536000, immutable"
      }
    ]
  }
]
  },
  "flutter": {
    "platforms": {
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "alma-green-tech",
          "configurations": {
            "web": "1:1090830148692:web:aa9df923dc430999b2f9c1"
          }
        }
      }
    }
  }
}